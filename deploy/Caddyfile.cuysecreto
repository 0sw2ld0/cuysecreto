
# CuySecreto · amigo secreto (estáticos; los datos viven en Supabase)
cuysecreto.cuycoders.dev {
	root * /srv/cuysecreto
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
	@noCache path / /index.html /config.js /app.js /styles.css
	header @noCache Cache-Control "no-cache"
	file_server
}
